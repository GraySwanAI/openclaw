{
  "id": "grayswan-cygnal-guardrail",
  "uiHints": {
    "apiKey": {
      "label": "API Key",
      "sensitive": true,
      "help": "Gray Swan Cygnal API key"
    },
    "apiBase": {
      "label": "API Base URL",
      "advanced": true,
      "help": "Override for Gray Swan API base URL"
    },
    "policyId": {
      "label": "Policy ID",
      "help": "Gray Swan policy identifier"
    },
    "reasoningMode": {
      "label": "Reasoning Mode",
      "advanced": true
    },
    "violationThreshold": {
      "label": "Violation Threshold",
      "help": "Default violation threshold (0-1)"
    },
    "timeoutMs": {
      "label": "Timeout (ms)",
      "advanced": true
    },
    "cygnalBypass": {
      "label": "Cygnal Bypass",
      "help": "Set metadata.cygnal_bypass=true so Cygnal only monitors"
    },
    "failOpen": {
      "label": "Fail Open",
      "help": "Allow requests on API errors"
    },
    "stages.beforeRequest.enabled": {
      "label": "Enabled",
      "help": "Enable guardrail check before user requests"
    },
    "stages.beforeRequest.mode": {
      "label": "Mode",
      "help": "Block violations or monitor only"
    },
    "stages.beforeToolCall.enabled": {
      "label": "Enabled",
      "help": "Enable guardrail check before tool calls"
    },
    "stages.beforeToolCall.mode": {
      "label": "Mode",
      "help": "Block violations or monitor only"
    },
    "stages.afterToolCall.enabled": {
      "label": "Enabled",
      "help": "Enable guardrail check after tool calls"
    },
    "stages.afterToolCall.mode": {
      "label": "Mode",
      "help": "Block violations or monitor only"
    },
    "stages.afterToolCall.blockOnMutation": {
      "label": "Block on Mutation",
      "help": "Block when mutation/jailbreak attempt detected"
    },
    "stages.afterToolCall.blockOnIpi": {
      "label": "Block on IPI",
      "help": "Block when indirect prompt injection detected"
    },
    "stages.afterResponse.enabled": {
      "label": "Enabled",
      "help": "Enable guardrail check after model responses"
    },
    "stages.afterResponse.mode": {
      "label": "Mode",
      "help": "Block violations or monitor only"
    },
    "guardrailPriority": {
      "label": "Guardrail Priority",
      "advanced": true,
      "help": "Higher runs earlier when multiple guardrails are enabled"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string"
      },
      "apiBase": {
        "type": "string"
      },
      "policyId": {
        "type": "string"
      },
      "categories": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "reasoningMode": {
        "type": "string",
        "enum": ["off", "hybrid", "thinking"]
      },
      "violationThreshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000
      },
      "cygnalBypass": {
        "type": "boolean"
      },
      "failOpen": {
        "type": "boolean"
      },
      "guardrailPriority": {
        "type": "integer"
      },
      "stages": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "beforeRequest": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "enum": ["block", "monitor"]
              },
              "violationThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blockMode": {
                "type": "string",
                "enum": ["replace", "append"]
              },
              "blockOnMutation": {
                "type": "boolean"
              },
              "blockOnIpi": {
                "type": "boolean"
              },
              "includeHistory": {
                "type": "boolean"
              }
            }
          },
          "beforeToolCall": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "enum": ["block", "monitor"]
              },
              "violationThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blockMode": {
                "type": "string",
                "enum": ["replace", "append"]
              },
              "blockOnMutation": {
                "type": "boolean"
              },
              "blockOnIpi": {
                "type": "boolean"
              },
              "includeHistory": {
                "type": "boolean"
              }
            }
          },
          "afterToolCall": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "enum": ["block", "monitor"]
              },
              "violationThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blockMode": {
                "type": "string",
                "enum": ["replace", "append"]
              },
              "blockOnMutation": {
                "type": "boolean"
              },
              "blockOnIpi": {
                "type": "boolean"
              },
              "includeHistory": {
                "type": "boolean"
              }
            }
          },
          "afterResponse": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "enum": ["block", "monitor"]
              },
              "violationThreshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blockMode": {
                "type": "string",
                "enum": ["replace", "append"]
              },
              "blockOnMutation": {
                "type": "boolean"
              },
              "blockOnIpi": {
                "type": "boolean"
              },
              "includeHistory": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
